# Build output
**/bin/
**/obj/
artifacts/
**/publish/
**/out/
packages/
*.nupkg
*.snupkg

# IDE and user-specific files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.rsuser
*.userprefs
*.DotSettings.user
_ReSharper*/

# Test and coverage output
TestResults/
coverage/
*.trx
*.coverage
*.coveragexml

# Front-end dependencies
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Keep only the browser assets referenced by the Razor views
**/wwwroot/lib/**/*.map
**/wwwroot/lib/**/*.css
!**/wwwroot/lib/bootstrap/dist/css/bootstrap.min.css
**/wwwroot/lib/**/*.js
!**/wwwroot/lib/bootstrap/dist/js/bootstrap.bundle.min.js
!**/wwwroot/lib/jquery/dist/jquery.min.js
!**/wwwroot/lib/jquery-validation/dist/jquery.validate.min.js
!**/wwwroot/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js

# Logs and local configuration
logs/
*.log
.env
.env.*
!.env.example
appsettings.Local.json
appsettings.local.json
appsettings.*.[Ll]ocal.json
*.publishsettings
*.pfx
*.p12
*.key
*.snk

# Temporary files and local backups
.cache/
.history/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~

# Local SQL Server files
*.mdf
*.ldf
*.ndf
*.bacpac
*.trn

