<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Valuetech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm app-navbar">
            <div class="container-xl">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Regiones" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">V</span>
                    <span>Valuetech <span class="brand-divider">·</span> Comunas</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Alternar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link app-nav-link" asp-area="" asp-controller="Regiones" asp-action="Index" aria-current="page">
                                <span class="nav-dot" aria-hidden="true"></span> Regiones
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="container-xl app-main">
        @RenderBody()
    </main>
    <footer class="app-footer">
        <div class="container-xl d-flex justify-content-between align-items-center gap-3">
            <span>Valuetech · Gestión territorial</span>
            <span class="footer-status"><span class="status-dot" aria-hidden="true"></span> Servicio conectado</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
