@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h3">No se pudo completar la solicitud</h1>
<p>Ocurrió un error inesperado. Intenta nuevamente.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador de seguimiento:</strong> <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Regiones" asp-action="Index" class="btn btn-primary">Volver a regiones</a>
