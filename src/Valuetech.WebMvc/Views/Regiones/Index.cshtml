@model IReadOnlyList<RegionModel>
@{ ViewData["Title"] = "Regiones"; }
<p class="text-uppercase text-muted small mb-2">Administración territorial</p>
<h1>Regiones</h1>
<p class="text-muted mb-4">Selecciona una región para consultar y editar sus comunas.</p>
@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay regiones registradas.</div>
}
<div class="row g-3">
@foreach (var region in Model)
{
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column align-items-start p-4">
                <span class="badge bg-light text-dark mb-3">Región @region.Id</span>
                <h2 class="h5 mb-4">@region.Nombre</h2>
                <a class="btn btn-primary mt-auto" asp-controller="Comunas" asp-action="Index"
                   asp-route-regionId="@region.Id" aria-label="Ver comunas de @region.Nombre">Ver comunas &rarr;</a>
            </div>
        </div>
    </div>
}
</div>
