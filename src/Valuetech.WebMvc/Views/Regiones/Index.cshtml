@model IReadOnlyList<RegionModel>
@{ ViewData["Title"] = "Regiones"; }

<section class="page-hero region-hero">
    <div>
        <p class="eyebrow"><span class="eyebrow-line"></span> Administración territorial</p>
        <h1>Explora tus regiones</h1>
        <p class="hero-copy">Consulta las comunas disponibles y mantén su información actualizada desde un solo lugar.</p>
    </div>
    <div class="hero-summary" aria-label="Resumen de regiones">
        <span class="hero-summary__number">@Model.Count</span>
        <span class="hero-summary__label">@(Model.Count == 1 ? "región disponible" : "regiones disponibles")</span>
    </div>
</section>
@if (Model.Count == 0)
{
    <div class="empty-state"><span class="empty-state__icon">◎</span><h2>No hay regiones registradas</h2><p>Cuando existan registros, aparecerán aquí.</p></div>
}
<div class="row g-4 region-grid">
@foreach (var region in Model)
{
    <div class="col-md-6 col-lg-4">
        <article class="region-card">
            <div class="region-card__topline"></div>
            <div class="region-card__body">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <span class="region-card__icon" aria-hidden="true">R</span>
                    <span class="region-card__id">REGIÓN @region.Id</span>
                </div>
                <h2>@region.Nombre</h2>
                <a class="region-card__link" asp-controller="Comunas" asp-action="Index"
                   asp-route-regionId="@region.Id" aria-label="Ver comunas de @region.Nombre">
                    Ver comunas <span aria-hidden="true">→</span>
                </a>
            </div>
        </article>
    </div>
}
</div>
