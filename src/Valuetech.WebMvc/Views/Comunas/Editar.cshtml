@model EditarComunaModel
@{ ViewData["Title"] = "Editar comuna"; }
<a asp-action="Index" asp-route-regionId="@Model.RegionId" class="text-decoration-none">&larr; Volver a comunas</a>
<h1 class="mt-3">Editar comuna</h1>
<p class="text-muted">@Model.RegionNombre</p>
<form asp-action="Editar" asp-route-regionId="@Model.RegionId" asp-route-id="@Model.Id" method="post" class="card p-4 shadow-sm edit-form">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <input asp-for="Id" type="hidden" />
    <input asp-for="RegionId" type="hidden" />
    <div class="mb-4">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" maxlength="100" autocomplete="off" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <fieldset>
        <legend class="h5">Información adicional</legend>
        <p class="text-muted small">Completa los tres campos o déjalos todos vacíos para guardar sin información adicional.</p>
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="Superficie" class="form-label"></label><input asp-for="Superficie" type="number" step="any" min="0" class="form-control" /><span asp-validation-for="Superficie" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="Poblacion" class="form-label"></label><input asp-for="Poblacion" type="number" step="1" min="0" class="form-control" /><span asp-validation-for="Poblacion" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="Densidad" class="form-label"></label><input asp-for="Densidad" type="number" step="any" min="0" class="form-control" /><span asp-validation-for="Densidad" class="text-danger"></span></div>
        </div>
    </fieldset>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Index" asp-route-regionId="@Model.RegionId" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
