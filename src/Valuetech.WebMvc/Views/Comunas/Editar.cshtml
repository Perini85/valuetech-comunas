@model EditarComunaModel
@{ ViewData["Title"] = "Editar comuna"; }

<a asp-action="Index" asp-route-regionId="@Model.RegionId" class="back-link"><span aria-hidden="true">←</span> Volver a comunas</a>
<section class="page-heading">
    <p class="eyebrow"><span class="eyebrow-line"></span> Administración de comunas</p>
    <h1>Editar comuna</h1>
    <p class="hero-copy">@Model.RegionNombre <span class="heading-separator">·</span> Actualiza los datos y guarda los cambios.</p>
</section>
<form asp-action="Editar" asp-route-regionId="@Model.RegionId" asp-route-id="@Model.Id" method="post" class="edit-card">
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    <input asp-for="Id" type="hidden" />
    <input asp-for="RegionId" type="hidden" />
    <div class="form-section">
        <div class="form-section__heading"><span class="form-section__number">01</span><div><h2>Identificación</h2><p>Nombre visible de la comuna.</p></div></div>
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" maxlength="100" autocomplete="off" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <fieldset class="form-section">
        <div class="form-section__heading"><span class="form-section__number">02</span><div><legend>Información adicional</legend><p>Datos opcionales para complementar el registro.</p></div></div>
        <p class="form-hint"><span aria-hidden="true">i</span> Completa los tres campos o déjalos vacíos para quitar la información adicional.</p>
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="Superficie" class="form-label"></label><div class="input-with-unit"><input asp-for="Superficie" type="number" step="any" min="0" class="form-control" /><span>km²</span></div><span asp-validation-for="Superficie" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="Poblacion" class="form-label"></label><div class="input-with-unit"><input asp-for="Poblacion" type="number" step="1" min="0" class="form-control" /><span>hab.</span></div><span asp-validation-for="Poblacion" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="Densidad" class="form-label"></label><div class="input-with-unit"><input asp-for="Densidad" type="number" step="any" min="0" class="form-control" /><span>hab./km²</span></div><span asp-validation-for="Densidad" class="text-danger"></span></div>
        </div>
    </fieldset>
    <div class="edit-actions">
        <a asp-action="Index" asp-route-regionId="@Model.RegionId" class="btn btn-quiet">Cancelar</a>
        <button type="submit" class="btn btn-primary btn-save"><span aria-hidden="true">✓</span> Guardar cambios</button>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
