@model ComunasIndexModel
@using System.Globalization
@{ ViewData["Title"] = Model.Region.Nombre; var culture = CultureInfo.GetCultureInfo("es-CL"); }

<a asp-controller="Regiones" asp-action="Index" class="back-link"><span aria-hidden="true">←</span> Todas las regiones</a>
<section class="page-hero comuna-hero">
    <div>
        <p class="eyebrow"><span class="eyebrow-line"></span> Región seleccionada</p>
        <h1>@Model.Region.Nombre</h1>
        <p class="hero-copy">Revisa el detalle de sus comunas y actualiza los datos que necesites.</p>
    </div>
    <div class="hero-summary" aria-label="Resumen de comunas">
        <span class="hero-summary__number">@Model.Comunas.Count</span>
        <span class="hero-summary__label">@(Model.Comunas.Count == 1 ? "comuna registrada" : "comunas registradas")</span>
    </div>
</section>
@if (TempData["Success"] is string message)
{
    <div class="alert app-alert app-alert--success" role="status"><span aria-hidden="true">✓</span> @message</div>
}
@if (Model.Comunas.Count == 0)
{
    <div class="empty-state"><span class="empty-state__icon">◎</span><h2>Esta región aún no tiene comunas</h2><p>Cuando existan registros, podrás administrarlos desde aquí.</p></div>
}
else
{
    <section class="data-card">
        <div class="data-card__header">
            <div><h2>Comunas de la región</h2><p>Información disponible para consulta y edición.</p></div>
            <span class="data-card__count">@Model.Comunas.Count registros</span>
        </div>
        <div class="table-responsive">
        <table class="table app-table align-middle mb-0">
            <caption>Superficie en km² y densidad en habitantes por km². — indica datos sin registrar.</caption>
            <thead><tr><th scope="col">Comuna</th><th scope="col" class="text-end">Superficie</th><th scope="col" class="text-end">Población</th><th scope="col" class="text-end">Densidad</th><th scope="col" class="text-end">Acción</th></tr></thead>
            <tbody>
            @foreach (var comuna in Model.Comunas)
            {
                <tr>
                    <th scope="row"><span class="comuna-name"><span class="comuna-avatar" aria-hidden="true">@comuna.Nombre[..1]</span>@comuna.Nombre</span></th>
                    <td class="text-end numeric-value">@(comuna.InformacionAdicional?.Superficie.ToString("N2", culture) ?? "—")</td>
                    <td class="text-end numeric-value">@(comuna.InformacionAdicional?.Poblacion.ToString("N0", culture) ?? "—")</td>
                    <td class="text-end numeric-value">@(comuna.InformacionAdicional?.Densidad.ToString("N2", culture) ?? "—")</td>
                    <td class="text-end"><a class="action-link" asp-action="Editar" asp-route-regionId="@Model.Region.Id"
                           asp-route-id="@comuna.Id" aria-label="Editar @comuna.Nombre">Editar</a></td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        <p class="data-card__note"><span aria-hidden="true">i</span> Puedes editar el nombre, la superficie, la población y la densidad de cada comuna.</p>
    </section>
}
